# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Trust registration (shown on About, Donate, Footer — set real values in production)
NEXT_PUBLIC_TRUST_PAN=
NEXT_PUBLIC_TRUST_12A=
NEXT_PUBLIC_TRUST_80G=

# Transparency PDFs live in public/documents/transparency/
# Add files there and set downloadPath in src/data/transparency-documents.ts

# Sanity CMS — staff portal at /studio (see /portal for guide)
# 1. Open https://www.sanity.io/manage → project "DREAM Academy" (r7loshm7)
# 2. API → Tokens → Add API token → Name: "Dream Academy local" → Permissions: Editor
# 3. Paste token below (must be for THIS project, not another org/project)
# 4. Run: npx sanity login  then  npm run sanity:verify  then  npm run sanity:setup
NEXT_PUBLIC_SANITY_PROJECT_ID=r7loshm7
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=

# Staff portal (custom frontend login — no Sanity access for editors)
STAFF_SESSION_SECRET=change-me-to-a-long-random-string
STAFF_PORTAL_PASSWORD=
STAFF_ALLOWED_EMAILS=chandradiabetesclinic@gmail.com

# Resend (contact + volunteer forms)
RESEND_API_KEY=

# Razorpay (donations)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (international donations)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
